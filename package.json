{
  "name": "youth-policy-data-hub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:e2e": "npm run build && node --test tests/rendered-html.test.mjs",
    "test:a11y": "npm run build && node --test tests/accessibility.test.mjs",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "validate:data": "node --import tsx scripts/validate-data.ts",
    "validate:sources": "node --import tsx scripts/validate-sources.ts",
    "validate:graph": "node --import tsx scripts/validate-graph.ts",
    "check:freshness": "node --import tsx scripts/check-freshness.ts",
    "validate:ingestion": "node --import tsx scripts/validate-ingestion-store.ts",
    "validate:all": "npm run validate:data && npm run validate:sources && npm run validate:graph && npm run check:freshness && npm run validate:ingestion",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "\uccad\ub144\uc815\ucc45\ub370\uc774\ud130\ud5c8\ube0c Y-HUB"
}
