{
  "name": "@00ai/youth-policy-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler deploy --dry-run --outdir dist",
    "check": "tsc --noEmit",
    "test": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vitest run",
    "test:watch": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vitest",
    "types": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler types worker-configuration.d.ts --include-runtime false",
    "db:migrate:local": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler d1 migrations apply 00ai-youth-policy --local",
    "db:migrate:remote": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler d1 migrations apply 00ai-youth-policy --remote",
    "deploy": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler deploy"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "fast-xml-parser": "5.11.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.0.0",
    "@cloudflare/workers-types": "5.20260823.1",
    "@types/node": "22.19.19",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.125.0"
  }
}
