{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "types": ["vite/client", "@cloudflare/workers-types/experimental"],
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src", "worker"]
}
