# 실제 비밀값은 여기에 적지 않습니다.
# Sites가 D1(DB)과 R2(BUCKET)를 런타임에 연결합니다.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 공개 저장소 자동 등록 계정. 토큰 없이도 공개 저장소는 동기화됩니다.
GITHUB_OWNER=ImZooMooGwan
# 선택 사항: API 호출 한도를 높일 때 런타임 비밀 환경변수로만 설정합니다.
GITHUB_TOKEN=
# 선택 사항: 쉼표로 구분한 제외 저장소 또는 필수 Topic 하나를 지정합니다.
GITHUB_EXCLUDE_REPOS=
GITHUB_PROJECT_TOPIC=
TURNSTILE_SECRET_KEY=
DROP_ADMIN_TOKEN=
